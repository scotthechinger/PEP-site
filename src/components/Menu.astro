---
// Scroll menu: pink hamburger appears once the header scrolls away and opens the Figma "Menu=Open" panel.
// The scroll button is the one addition to the Figma spec, per Scott.
import Arrow from './Arrow.astro';
import { nav, donate, site } from '../data/site.js';
---
<button class="burger" type="button" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu"><span class="menu-icon" aria-hidden="true"><i></i><i></i><i></i></span></button>
<div class="menu-scrim" aria-hidden="true"></div>
<div class="menu-panel" id="site-menu" role="dialog" aria-modal="true" aria-label="Site menu">
  <div class="menu-bar">
    <a class="logo" href="/" aria-label={`${site.name} — home`}><img src="/assets/logo.svg" alt={site.name} width="197.5" height="53.49"></a>
    <div class="menu-actions">
      <a class="btn" href={donate.href}>{donate.label} <Arrow /></a>
      <button class="menu-close" type="button" aria-label="Close menu"><span class="close-icon" aria-hidden="true"><i></i><i></i></span></button>
    </div>
  </div>
  <nav class="menu-links" aria-label="Menu">
    {nav.map((item, i) => <a class="navlink" href={item.href} style={`--i:${i}`}>{item.label}</a>)}
    <a class="btn" href={donate.href} style={`--i:${nav.length}`}>{donate.label} <Arrow /></a>
  </nav>
</div>

<script src="../scripts/menu.js"></script>
