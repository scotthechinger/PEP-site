---
// Icon · Arrow (36px circle). Colors come from CSS vars --circle / --arrow, set per section.
interface Props { circle?: string; prev?: boolean; class?: string }
const { circle, prev = false, class: cls = '' } = Astro.props;
---
<svg class:list={['arrow', prev && 'is-prev', cls]} style={circle ? `--circle:${circle}` : undefined} aria-hidden="true"><use href="#i-arrow"/></svg>
